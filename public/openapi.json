{
  "openapi": "3.1.0",
  "info": {
    "title": "ExtractPDF",
    "version": "1.0.0",
    "description": "Pay-per-use PDF and DOCX text extraction API for AI agents. $0.01 USDC per call. No API key, no account, no subscription.",
    "x-guidance": "POST /api/extract with JSON body {\"url\": \"<public PDF or DOCX URL>\"}. Pay $0.01 USDC via x402 or MPP. Returns: text (plain text, up to 50k chars), chars (int), pages (int, PDF only), format (pdf|docx|text), title, author, extracted_at (ISO datetime). Use when you need to read the text content of a PDF or Word document at a public URL. Supports Base, Arc, and Polygon chains.",
    "contact": {
      "email": "artespraticas@gmail.com",
      "url": "https://www.extractpdf.xyz"
    },
    "x-payment-info": {
      "price": {
        "mode": "fixed",
        "amount": "0.010000",
        "currency": "USDC"
      },
      "protocols": [
        { "x402": {} },
        { "mpp": { "method": "", "intent": "", "currency": "" } }
      ],
      "networks": [
        { "chain": "base", "asset": "USDC" },
        { "chain": "polygon", "asset": "USDC" },
        { "chain": "arc", "asset": "USDC" }
      ]
    }
  },
  "externalDocs": {
    "url": "https://www.extractpdf.xyz",
    "description": "Full documentation, examples, and pricing"
  },
  "servers": [
    { "url": "https://www.extractpdf.xyz", "description": "Production" }
  ],
  "paths": {
    "/api/extract": {
      "get": {
        "operationId": "healthCheck",
        "summary": "Service info",
        "description": "Returns service status, supported formats, pricing, and endpoint details. No payment required.",
        "x-auth-mode": "none",
        "security": [],
        "responses": {
          "200": {
            "description": "Service info",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ServiceInfo" }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "extractDocument",
        "summary": "Extract text from a PDF or DOCX document",
        "description": "Fetches the document at the provided URL and returns extracted plain text with metadata. Supports PDF and DOCX formats. Requires $0.01 USDC payment via x402 or MPP.",
        "x-auth-mode": "payment",
        "security": [{ "mpp": [] }],
        "x-payment-info": {
          "price": {
            "mode": "fixed",
            "amount": "0.010000",
            "currency": "USDC"
          },
          "protocols": [
            { "x402": {} },
            { "mpp": { "method": "", "intent": "", "currency": "" } }
          ],
          "networks": [
            { "chain": "base", "asset": "USDC" },
            { "chain": "polygon", "asset": "USDC" },
            { "chain": "arc", "asset": "USDC" }
          ]
        },
        "extensions": {
          "bazaar": {
            "schema": {
              "properties": {
                "input": {
                "type": "object",
                "required": ["url"],
                "properties": {
                  "url": {
                    "type": "string",
                    "format": "uri",
                    "description": "Publicly accessible URL of a PDF or DOCX document"
                  }
                }
              },
              "output": {
                "type": "object",
                "required": ["text", "chars", "format", "extracted_at"],
                "properties": {
                  "text": { "type": "string", "description": "Extracted plain text, up to 50,000 characters" },
                  "chars": { "type": "integer", "description": "Character count" },
                  "pages": { "type": "integer", "description": "Page count (PDF only)" },
                  "format": { "type": "string", "enum": ["pdf", "docx", "text"] },
                  "extracted_at": { "type": "string", "format": "date-time" }
                }
              }
            }
          }
        }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ExtractRequest" },
              "examples": {
                "pdf": {
                  "summary": "Extract a PDF",
                  "value": { "url": "https://upload.wikimedia.org/wikipedia/commons/1/13/Example.pdf" }
                },
                "docx": {
                  "summary": "Extract a DOCX",
                  "value": { "url": "https://example.com/report.docx" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Extracted document content",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ExtractResponse" }
              }
            }
          },
          "400": {
            "description": "Missing or invalid url field"
          },
          "402": {
            "description": "Payment required — attach a valid x402 or MPP payment header and retry",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PaymentRequired" }
              }
            }
          },
          "500": {
            "description": "Extraction failed — document could not be fetched or parsed"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "mpp": {
        "type": "http",
        "scheme": "mpp",
        "description": "MPP micropayment — $0.01 USDC via WWW-Authenticate challenge"
      }
    },
    "schemas": {
      "ExtractRequest": {
        "type": "object",
        "required": ["url"],
        "properties": {
          "url": {
            "type": "string",
            "format": "uri",
            "description": "Publicly accessible URL of a PDF or DOCX document. Must return the file directly (not an HTML page). Example: https://example.com/report.pdf"
          }
        }
      },
      "ExtractResponse": {
        "type": "object",
        "required": ["url", "text", "chars", "format", "extracted_at"],
        "properties": {
          "url": { "type": "string", "description": "The URL that was fetched" },
          "text": { "type": "string", "description": "Extracted plain text content, up to 50,000 characters" },
          "chars": { "type": "integer", "description": "Total character count of the extracted text" },
          "pages": { "type": "integer", "description": "Total page count (PDF only)" },
          "format": { "type": "string", "enum": ["pdf", "docx", "text"], "description": "Detected document format" },
          "info": {
            "type": "object",
            "description": "Document metadata (PDF only)",
            "properties": {
              "title": { "type": "string", "description": "Document title from metadata" },
              "author": { "type": "string", "description": "Document author from metadata" },
              "subject": { "type": "string", "description": "Document subject from metadata" }
            }
          },
          "extracted_at": { "type": "string", "format": "date-time", "description": "ISO 8601 timestamp of when the extraction was performed" }
        }
      },
      "ServiceInfo": {
        "type": "object",
        "properties": {
          "service": { "type": "string" },
          "description": { "type": "string" },
          "price": { "type": "string" },
          "endpoint": { "type": "string" },
          "accepts_formats": { "type": "array", "items": { "type": "string" } },
          "docs": { "type": "string" }
        }
      },
      "PaymentRequired": {
        "type": "object",
        "properties": {
          "x402Version": { "type": "integer" },
          "error": { "type": "string" },
          "accepts": { "type": "array" }
        }
      }
    }
  }
}
