{
  "version": 2,
  "functions": {
    "api/extract.js": { "maxDuration": 30 }
  },
  "routes": [
    { "src": "/api/extract-web", "dest": "/api/extract.js" },
    { "src": "/mcp", "dest": "/api/extract.js" },
    { "src": "/api/extract",     "dest": "/api/extract.js" },
    { "src": "/openapi.json",    "dest": "/public/openapi.json" },
    { "src": "/llms.txt",        "dest": "/public/llms.txt" },
    { "src": "/.well-known/x402","dest": "/public/.well-known/x402" },
    { "src": "/.well-known/mpp", "dest": "/public/.well-known/mpp" },
    { "src": "/.well-known/mcp/server-card.json","dest": "/public/.well-known/mcp/server-card.json" },
    { "src": "/assets/(.*)",     "dest": "/public/assets/$1" },
    { "src": "/(.*)",            "dest": "/public/index.html" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin",  "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, X-PAYMENT, PAYMENT-SIGNATURE, Accept" }
      ]
    }
  ]
}
