{
  "functions": {
    "api/extract.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/extract-web", "destination": "/api/extract" },
    { "source": "/api/extract",     "destination": "/api/extract" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin",  "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, X-PAYMENT, PAYMENT-SIGNATURE, Accept" },
        { "key": "Access-Control-Expose-Headers","value": "PAYMENT-REQUIRED, WWW-Authenticate" }
      ]
    }
  ]
}
